{
  "$comment": "Single source of truth for mobile and web design tokens (WEBD-03). Edit this file, then run `npm run tokens`. Never edit generated files.",
  "color": {
    "nocturne": {
      "ink": "#0F0E0D",
      "smoke": "#1A1817",
      "lacquer": "#2A1416",
      "vellum": "#ECE4D6",
      "ash": "#9A9186",
      "verdigris": "#6E9A8C",
      "oxblood": "#7A2630",
      "resin": "#B9864F",
      "onAccent": "#F2ECE1",
      "hairline": { "base": "vellum", "alpha": 0.1 }
    },
    "atelier": {
      "ink": "#F2ECE1",
      "smoke": "#E8E0D1",
      "lacquer": "#E3D3CC",
      "vellum": "#0F0E0D",
      "ash": "#5C554C",
      "verdigris": "#3D6A5C",
      "oxblood": "#6E1F29",
      "resin": "#855A26",
      "onAccent": "#F2ECE1",
      "hairline": { "base": "vellum", "alpha": 0.12 }
    },
    "$roles": "In Atelier the token names keep their role: ink is the page background and vellum is the primary text colour, so screens never branch on theme."
  },
  "rarity": {
    "inProduction": { "label": "In production", "color": "ash", "seal": "circle" },
    "reformulated": { "label": "Reformulated", "color": "resin", "seal": "square" },
    "discontinued": { "label": "Discontinued", "color": "verdigris", "seal": "hexagon" },
    "vintage": { "label": "Vintage", "color": "oxblood", "seal": "octagon" },
    "numberedLimited": {
      "label": "Numbered limited",
      "color": "iridescent",
      "seal": "crest",
      "drift": ["verdigris", "resin", "oxblood"]
    }
  },
  "type": {
    "family": {
      "display": "Fraunces",
      "text": "Inter Tight"
    },
    "scale": {
      "displayXL": { "family": "display", "size": 44, "height": 1.05, "tracking": -0.03, "weight": 400 },
      "displayL": { "family": "display", "size": 32, "height": 1.1, "tracking": -0.02, "weight": 400 },
      "titleM": { "family": "display", "size": 22, "height": 1.2, "tracking": -0.01, "weight": 400 },
      "bodyM": { "family": "text", "size": 16, "height": 1.5, "tracking": 0, "weight": 400 },
      "labelS": { "family": "text", "size": 11, "height": 1.3, "tracking": 0.12, "weight": 500, "smallCaps": true },
      "numeralL": { "family": "text", "size": 28, "height": 1.1, "tracking": -0.01, "weight": 300, "tabular": true }
    }
  },
  "motion": {
    "curve": {
      "settle": [0.2, 0.0, 0.0, 1.0],
      "drawer": [0.32, 0.72, 0.0, 1.0]
    },
    "durationMs": { "ui": 280, "hero": 520, "ceremony": 900 }
  },
  "space": { "xs": 4, "s": 8, "m": 16, "l": 24, "xl": 40, "xxl": 64 },
  "radius": { "none": 0, "hair": 2, "panel": 6 },
  "layout": { "minTouchTarget": 44, "gutter": 20 },
  "contrast": {
    "$comment": "Pairs checked for WCAG AA (DS-03) in both themes. min is the required ratio.",
    "pairs": [
      { "fg": "vellum", "bg": "ink", "min": 4.5 },
      { "fg": "vellum", "bg": "smoke", "min": 4.5 },
      { "fg": "vellum", "bg": "lacquer", "min": 4.5 },
      { "fg": "ash", "bg": "ink", "min": 4.5 },
      { "fg": "ash", "bg": "smoke", "min": 4.5 },
      { "fg": "verdigris", "bg": "ink", "min": 4.5 },
      { "fg": "verdigris", "bg": "smoke", "min": 4.5 },
      { "fg": "resin", "bg": "ink", "min": 4.5 },
      { "fg": "resin", "bg": "smoke", "min": 4.5 },
      { "fg": "onAccent", "bg": "oxblood", "min": 4.5 }
    ]
  }
}
