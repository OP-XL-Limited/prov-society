# provenance_society mobile. Copy to .env and run with:
#   flutter run --dart-define-from-file=.env
# Never commit .env (OPS-01). SECX-03: the anon key is the ONLY secret-class
# value allowed in the build. Service role, webhook secrets and certificates
# live server-side only.
PS_ENV=local
PS_SUPABASE_URL=http://127.0.0.1:54321
PS_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Public SDK keys (safe in the build, restricted by the vendor to this app id).
PS_REVENUECAT_IOS_KEY=
PS_REVENUECAT_ANDROID_KEY=
PS_SENTRY_DSN=
# Set to true to force mock repositories even when keys are present.
PS_USE_MOCKS=true
