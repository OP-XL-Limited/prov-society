# Edge Function and job secrets. Copy to supabase/.env for local serving
# (supabase functions serve --env-file supabase/.env). In staging and
# production set these with `supabase secrets set` (SECX-18). Never commit.
SUPABASE_SERVICE_ROLE_KEY=
REVENUECAT_WEBHOOK_SECRET=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_CERT_P12_BASE64=
APPLE_WALLET_CERT_PASSWORD=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_BASE64=
FCM_SERVICE_ACCOUNT_JSON=
EMAIL_PROVIDER_API_KEY=
OWNER_ALERT_EMAIL=
